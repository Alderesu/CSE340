<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>
    <p><%= projectDetails.description %></p>
    <p><strong>Date:</strong> <%= projectDetails.project_date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p><strong>Location:</strong> <%= projectDetails.location %></p>
    <p><strong>Organization:</strong>
        <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a>
    </p>

    <% if (user && user.role_name === 'admin') { %>
        <p>
            <a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a> |
            <a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a>
        </p>
    <% } %>

    <% if (isLoggedIn) { %>
        <p class="volunteer-box">
            <% if (isVolunteering) { %>
                <strong>You are volunteering for this project.</strong>
                <a href="/project/<%= projectDetails.project_id %>/unvolunteer">Remove me as a volunteer</a>
            <% } else { %>
                <a href="/project/<%= projectDetails.project_id %>/volunteer">Volunteer for this project</a>
            <% } %>
        </p>
    <% } %>

    <h3>Categories</h3>
    <ul class="tag-list">
        <% categories.forEach(category => { %>
            <li class="tag"><a href="/category/<%= category.category_id %>"><%= category.name %></a></li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>

<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2>Welcome, <%= name %>!</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">Manage Registered Users</a></p>
    <% } %>

    <h3>Projects You Are Volunteering For</h3>
    <% if (volunteeredProjects.length > 0) { %>
        <ul>
            <% volunteeredProjects.forEach(project => { %>
                <li>
                    <strong><%= project.project_date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>:</strong>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    (<%= project.organization_name %>)
                    &mdash; <a href="/project/<%= project.project_id %>/unvolunteer">Remove</a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>You have not volunteered for any projects yet. Browse the <a href="/projects">service projects</a> to sign up!</p>
    <% } %>
</main>
<%- include('partials/footer') %>
